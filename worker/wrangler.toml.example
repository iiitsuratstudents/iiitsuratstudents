name = "setu-api"
main = "worker.js"
compatibility_date = "2026-09-01"

# Bind a D1 database after creating it:
# [[d1_databases]]
# binding = "DB"
# database_name = "setu"
# database_id = "YOUR_DATABASE_ID"

# Cloudflare Workers AI — no browser API key required.
# [ai]
# binding = "AI"

[vars]
ALLOWED_ORIGIN = "https://iiitsuratstudents.github.io"
AI_PROVIDER = "workers-ai"
AI_MODEL = "@cf/zai-org/glm-4.7-flash"

# Optional Gemini instead of Workers AI:
# AI_PROVIDER = "gemini"
# AI_MODEL = "gemini-2.5-flash-lite"
# Then: npx wrangler secret put GEMINI_API_KEY
